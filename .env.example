# Where the FastAPI service is listening. Copy this file to .env.local.
# Leave it unset and the client assumes http://127.0.0.1:8000, which is what
# `uvicorn app.main:app --reload` gives you in the backend folder.
#
# The site works with no API at all: the sandbox simulates in the browser and
# the tutor says so instead of pretending.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
