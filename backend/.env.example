# The tutor's model provider. Anything that speaks the OpenAI Chat Completions
# API works here — the variable names are the SDK's conventions, not a vendor.
# Leave the key empty and the tutor still answers, from a Qiskit read-out of the
# circuit on screen; only the conversational phrasing is lost.
#
# Groq has a free tier and is the recommended setting:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   QUANTAVERSE_TUTOR_MODEL=openai/gpt-oss-120b
# For OpenAI proper, leave OPENAI_BASE_URL empty and use e.g. gpt-4o-mini.
#
# The model must match the provider. A key from one with a model name from the
# other fails, and the failure is quiet: the tutor drops back to the read-out.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
QUANTAVERSE_TUTOR_MODEL=openai/gpt-oss-120b
QUANTAVERSE_TUTOR_TEMPERATURE=0.3
# Reasoning models spend part of this budget thinking before they answer.
QUANTAVERSE_TUTOR_MAX_TOKENS=1200
QUANTAVERSE_HOST=127.0.0.1
QUANTAVERSE_PORT=8000
QUANTAVERSE_ALLOWED_ORIGINS=*
QUANTAVERSE_DEFAULT_BACKEND=qiskit
QUANTAVERSE_DEFAULT_SHOTS=1024
QUANTAVERSE_SANDBOX_TIMEOUT=5
QUANTAVERSE_DATABASE_URL=
QUANTAVERSE_DATABASE_ECHO=0
QUANTAVERSE_JWT_SECRET=
QUANTAVERSE_ACCESS_TOKEN_MINUTES=30
QUANTAVERSE_REFRESH_TOKEN_DAYS=30
QUANTAVERSE_MAX_SESSIONS=10
QUANTAVERSE_REGISTRATION_OPEN=1
